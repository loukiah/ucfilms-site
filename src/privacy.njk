---
pagination:
  data: langs
  size: 1
  alias: lang
langs: ["en", "de"]
layout: base.njk
permalink: "{{ routes.privacy[lang] }}"
eleventyComputed:
  pageKind: legal
  pageTitle: "{{ i18n[lang].privacy }}"
  selfUrl: "{{ routes.privacy[lang] }}"
  enUrl: "{{ routes.privacy.en }}"
  deUrl: "{{ routes.privacy.de }}"
---
<section class="legal wrap prose">
{%- set doc = legal["privacy_" + lang] %}
<h1>{{ doc.title }}</h1>
{{ doc.body | rich | safe }}
</section>
