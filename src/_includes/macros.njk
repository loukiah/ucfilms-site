{% macro loopVideo(p, cls) -%}
<video class="{{ cls }}" muted playsinline loop preload="none" aria-hidden="true"
  {% if p.poster %}poster="{{ p.poster }}"{% endif %}
  data-loop="{{ p.loop_link if p.loop_link else p.loop }}"
  {% if p.loop_link %}data-start="{{ p.loop_start or 0 }}" data-length="10"{% endif %}></video>
{%- endmacro %}

{% macro sayHello(L, routes, lang) %}
<section class="hello">
  <h2 class="hello-title">{{ L.say }} <em class="accent">{{ L.hello }}</em></h2>
  <a class="button" href="{{ routes.contact[lang] }}">{{ L.tell_us }}</a>
</section>
{% endmacro %}
