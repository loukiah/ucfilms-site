---
pagination:
  data: langs
  size: 1
  alias: lang
langs: ["en", "de"]
layout: base.njk
permalink: "{{ routes.contact[lang] }}"
eleventyComputed:
  pageKind: contact
  pageTitle: "{{ i18n[lang].contact }}"
  selfUrl: "{{ routes.contact[lang] }}"
  enUrl: "{{ routes.contact.en }}"
  deUrl: "{{ routes.contact.de }}"
---
{%- set L = i18n[lang] -%}
<section class="contact-page wrap">
  <p class="contact-kicker">{{ L.contact_kicker }}</p>
  <a class="contact-email" href="mailto:{{ site.email }}">{{ site.email }}</a>
</section>
